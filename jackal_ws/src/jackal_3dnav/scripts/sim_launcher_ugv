#!/usr/bin/env bash
# Author: Luigi Freda

# Retry wrapper function for open_term
open_term_with_retry() {
    local name="$1"
    local command="$2"
    local max_attempts=5
    local attempt=1

    while [ $attempt -le $max_attempts ]; do
        # Try to open the terminal
        xterm $XTERM_OPTIONS -T "$name" -e bash -c "$command" &
        local xterm_pid=$!
        
        # Give the terminal a moment to start
        sleep 2
        
        # Check if the process is still running 
        if kill -0 "$xterm_pid" 2>/dev/null; then
            echo "Successfully opened terminal for $name on attempt $attempt"
            return 0
        fi
        
        # If not successful, wait and retry
        echo "Failed to open terminal for $name (attempt $attempt/$max_attempts)"
        sleep 2
        
        ((attempt++))
    done
    
    # If all attempts fail, print an error
    echo "ERROR: Could not open terminal for $name after $max_attempts attempts"
    return 1
}

echo "usage: ./${0##*/} <robot-id> <enable-multi-robot-traversability> <enable-TEB-local-planner> <enable-voxblox> <enable-elevation-mapping>"

export ROBOT_ID=$1
export ROBOT_NAME="ugv$ROBOT_ID"

if [[ -n "$ROBOT_ID" ]]; then
    echo "STARTING PP ROBOT $ROBOT_NAME"
else
    echo "give me a name please"
    exit 1
fi

export XTERM_OPTIONS="-hold -iconic" # the "iconic" option allows to automatically minimize all the launched xterms

export ROS_LOG_OPTIONS="--wait" # --log"  # uncomment if you want roslaunch to be used with this option 

########################################################################################################

ENABLE_VOXBLOX=0 # 1 use voxblox for mapping instead of octomap, 0 use octomap 

ENABLE_QUEUE_PATH_PLANNER=1 # 1 queue path (multi-WP) planner, 0 (single-WP) path planner

ENABLE_LASER_ASSEMBLER=1 #1 laser assembler enabled, 0 disabled

ENABLE_MULTI_ROBOT_COORDINATION="true" # true or false

ENABLE_LASER_PROXIMITY_CHECKER=1 # 1 use laser proximity checker

ENABLE_LOCAL_PATH_PLANNER=1 # 1 enable local planner,
                     # 0 disable local path planner

ENABLE_TRAJECTORY_CONTROL=1 # 1 enable trajectory control,
                     # 0 disable trajectory control 

ENABLE_TEB_LOCAL_PLANNER=0 # 1 enable TEB local planner,
                           # 0 disable TEB local path planner

ENABLE_ELEVATION_MAPPING=0 # 1 enable robot-centric elevation mapping,
                           # 0 disable robot-centric elevation mapping

########################################################################################################

if [[ -z "${MR3D_HOME}" ]]; then
    echo "ERROR: missing env var MR3D_HOME"
    echo "please, source source_all.bash in the main 3DMR folder"
    exit
else
    source $MR3D_HOME/source_all.bash
fi

########################################################################################################

# check if we want to enable/disable multi-robot from input
export ENABLE_MULTI_ROBOT_COORDINATION_INPUT=$2
if [[ -n "$ENABLE_MULTI_ROBOT_COORDINATION_INPUT" ]]
then
    echo "setting ENABLE_MULTI_ROBOT_COORDINATION_INPUT: $ENABLE_MULTI_ROBOT_COORDINATION_INPUT"
    ENABLE_MULTI_ROBOT_COORDINATION=$ENABLE_MULTI_ROBOT_COORDINATION_INPUT
fi
echo "ENABLE_MULTI_ROBOT_COORDINATION: $ENABLE_MULTI_ROBOT_COORDINATION"

########################################################################################################

# check if we want to enable/disable TEB local planner
export TEB_LOCAL_PLANNER_INPUT=$3
if [[ -n "$TEB_LOCAL_PLANNER_INPUT" ]]; then
    echo "setting TEB_LOCAL_PLANNER_INPUT: $TEB_LOCAL_PLANNER_INPUT"
    ENABLE_TEB_LOCAL_PLANNER=$TEB_LOCAL_PLANNER_INPUT   
fi
echo "ENABLE_TEB_LOCAL_PLANNER: $ENABLE_TEB_LOCAL_PLANNER"

if [ $ENABLE_TEB_LOCAL_PLANNER -eq 1 ]; then
    ENABLE_LOCAL_PATH_PLANNER=0 # enforce
    ENABLE_TRAJECTORY_CONTROL=0 # enforce 
    echo "ENABLE_LOCAL_PATH_PLANNER: $ENABLE_LOCAL_PATH_PLANNER" 
    echo "ENABLE_TRAJECTORY_CONTROL: $ENABLE_TRAJECTORY_CONTROL" 
fi 

########################################################################################################

# check if we want to enable/disable voxblox
export ENABLE_VOXBLOX_INPUT=$4
if [[ -n "$ENABLE_VOXBLOX_INPUT" ]]; then
    echo "setting ENABLE_VOXBLOX_INPUT: $ENABLE_VOXBLOX_INPUT"
    ENABLE_VOXBLOX=$ENABLE_VOXBLOX_INPUT   
fi
echo "ENABLE_VOXBLOX: $ENABLE_VOXBLOX"

########################################################################################################

# check if we want to enable/disable voxblox
export ENABLE_ELEVATION_MAPPING_INPUT=$5
if [[ -n "$ENABLE_ELEVATION_MAPPING_INPUT" ]]; then
    echo "setting ENABLE_ELEVATION_MAPPING_INPUT: $ENABLE_ELEVATION_MAPPING_INPUT"
    ENABLE_ELEVATION_MAPPING=$ENABLE_ELEVATION_MAPPING_INPUT   
fi
echo "ENABLE_ELEVATION_MAPPING: $ENABLE_ELEVATION_MAPPING"

########################################################################################################

if [ $ENABLE_QUEUE_PATH_PLANNER -eq 1 ]
then
    echo "using queue path planner"
fi

########################################################################################################
#- Here we use an independent volumetric MAPPING node for each ugv

#- Scan filter
echo "$ROBOT_NAME scan filter"
open_term_with_retry "$ROBOT_NAME"scanfilter  "echo $ROBOT_NAME scanfilter; roslaunch $ROS_LOG_OPTIONS scan_space_time_filter sim_scan_filter_jackal_ugv.launch robot_name:=$ROBOT_NAME; bash" &
sleep 1

if [ $ENABLE_VOXBLOX -eq 1 ]
then
    #- Mapping (Voxblox)  + Normal Estimation
    echo "$ROBOT_NAME mapping with voxblox"
    open_term_with_retry "$ROBOT_NAME"mapping_voxblox  "echo $ROBOT_NAME voxblox mapping; roslaunch $ROS_LOG_OPTIONS voxblox_ros pointcloud_ugv1.launch robot_name:=$ROBOT_NAME pointcloud_in:=/$ROBOT_NAME/filtered_pointcloud; bash" &
    sleep 2
    open_term_with_retry "$ROBOT_NAME"normal_estimation  "echo $ROBOT_NAME normal_estimation mapping; roslaunch $ROS_LOG_OPTIONS path_planner sim_compute_normals_jackal_ugv.launch robot_name:=$ROBOT_NAME cloud_in:=/voxblox_node_$ROBOT_NAME/mesh_pointcloud; bash" &

else 
    #- Mapping (Octomap) + Normal Estimation
    echo "$ROBOT_NAME mapping with octomap"
    open_term_with_retry "$ROBOT_NAME"mapping_octomap  "echo $ROBOT_NAME octomap mapping; roslaunch $ROS_LOG_OPTIONS path_planner sim_volumetric_mapping_jackal_ugv.launch robot_name:=$ROBOT_NAME laser_frame_name:=$ROBOT_NAME/ouster_lidar octomap_cloud_in:=/$ROBOT_NAME/filtered_pointcloud tf_cache_length:=10; bash" &
    sleep 2
fi 

########################################################################################################

#- Traversability 
echo "$ROBOT_NAME traversability"
open_term_with_retry "$ROBOT_NAME"traversability  "echo $ROBOT_NAME traversability; roslaunch $ROS_LOG_OPTIONS path_planner sim_traversability_jackal_ugv.launch robot_name:=$ROBOT_NAME enable_multi_robot_avoidance:=$ENABLE_MULTI_ROBOT_COORDINATION; bash" &
sleep 2

########################################################################################################

#- Path Planner
if [ $ENABLE_QUEUE_PATH_PLANNER -eq 1 ]
then
	# global path planner (queue path planner) + local path planner (path planner manager)
    echo "$ROBOT_NAME queue path planner"
    open_term_with_retry "$ROBOT_NAME"queue_path_planner  "echo $ROBOT_NAME queue path planner; roslaunch $ROS_LOG_OPTIONS path_planner sim_queue_path_planner_jackal_ugv.launch robot_name:=$ROBOT_NAME; bash" &
	sleep 2
    if [ $ENABLE_LOCAL_PATH_PLANNER -eq 1 ]; then    
        echo "$ROBOT_NAME path planner manager"
	    open_term_with_retry "$ROBOT_NAME"path_planner_manager  "echo $ROBOT_NAME path planner manager; roslaunch path_planner sim_path_planner_manager_jackal_ugv.launch robot_name:=$ROBOT_NAME use_marker_controller:=false; bash" &
    fi
else
    if [ $ENABLE_LOCAL_PATH_PLANNER -eq 1 ]; then
        echo "$ROBOT_NAME path planner manager"
	    open_term_with_retry "$ROBOT_NAME"path_planner_manager  "echo $ROBOT_NAME path planner manager; roslaunch path_planner sim_path_planner_manager_jackal_ugv.launch robot_name:=$ROBOT_NAME; bash" &
    fi
fi

sleep 2

########################################################################################################

#- Trajectory Control
if [ $ENABLE_TRAJECTORY_CONTROL -eq 1 ]; then
    echo "$ROBOT_NAME trajectory control"
    open_term_with_retry "$ROBOT_NAME"trajectory_control  "echo $ROBOT_NAME trajectory control; roslaunch trajectory_control sim_trajectory_control_jackal.launch robot_name:=$ROBOT_NAME; bash" &
fi 

########################################################################################################

#- TEB Local Planner 
if [ $ENABLE_TEB_LOCAL_PLANNER -eq 1 ]; then
    echo "$ROBOT_NAME teb_local_planner"
    open_term_with_retry "$ROBOT_NAME"teb_local_planner  "echo $ROBOT_NAME TEB local planner; roslaunch teb_optim_local_planner sim_teb_optim_node_jackal_ugv.launch robot_name:=$ROBOT_NAME; bash" &
fi 

########################################################################################################

#- Elevation Mapping 
if [ $ENABLE_ELEVATION_MAPPING -eq 1 ]; then
    echo "$ROBOT_NAME elevation mapping"
    open_term_with_retry "$ROBOT_NAME"elevation_mapping  "echo $ROBOT_NAME elevation mapping; roslaunch elevation_mapping_ugvs elevation_mapping_ugv.launch robot_name:=$ROBOT_NAME use_rviz:=false; bash" &
fi 

########################################################################################################

#- Laser proximity checker
if [ $ENABLE_LASER_PROXIMITY_CHECKER -eq 1 ]; then
    open_term_with_retry "$ROBOT_NAME"laser_proximity_checker  "echo $ROBOT_NAME laser proximity checker; roslaunch laser_proximity_checker sim_laser_proximity_checker_jackal_ugv.launch robot_name:=$ROBOT_NAME; bash" &
fi

echo "DONE WITH ROBOT $ROBOT_NAME"